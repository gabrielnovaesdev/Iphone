{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Sem dependências para instalar'",
  "buildCommand": "echo 'Site estático, sem etapa de build'",
  "outputDirectory": "src",
  "headers": [
    {
      "source": "/assets/video/(.*)",
